rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to read works and their subcollections
    match /works/{workId} {
      // Allow reading for everyone
      allow read;
      
      // Allow authenticated users to update documents, focusing on likes and comments
      allow update: if request.auth != null && 
        // Check that we're only updating likes OR comments fields
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) || 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments']));
      
      // Apply the same rules to any subcollections
      match /{document=**} {
        allow read;
        allow update: if request.auth != null;
      }
    }
    
    // Default deny all other operations
    match /{document=**} {
      allow read, write: if false;
    }
  }
}